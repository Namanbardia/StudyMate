
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "backend",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-04",

  "vars": {
    "FIREBASE_PROJECT_ID": "studymate-ai-ede5a",
    "FIREBASE_CERT_TIMEOUT_MS": "10000",
    "APP_ORIGIN": "https://studymate.studymateapp.workers.dev",
    "ENABLE_DEV_DIAGNOSTICS": "true"
  },

  "d1_databases": [
    {
      "binding": "SEARCH_CACHE_DB",
      "database_name": "studymate-db",
      "database_id": "4d6ef822-7203-47b0-8674-cc4392aefe5e"
    }
  ],

  "env": {
    "dev": {
      "vars": {
        "FIREBASE_PROJECT_ID": "studymate-ai-ede5a",
        "FIREBASE_CERT_TIMEOUT_MS": "10000",
        "APP_ORIGIN": "https://studymate.studymateapp.workers.dev",
        "ENABLE_DEV_DIAGNOSTICS": "true"
      },

      "d1_databases": [
        {
          "binding": "SEARCH_CACHE_DB",
          "database_name": "studymate-db-dev",
          "database_id": "debc638d-18ef-4cb2-9ab3-f1b5436edbc5",
          "remote": true
        }
      ]
    }
  },

  "observability": {
    "enabled": true
  },

  "upload_source_maps": true
}
